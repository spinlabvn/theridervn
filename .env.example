# URL công khai của website (dùng cho SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://therider.vn

# Sanity CMS – để trống thì website dùng bài viết mẫu trong src/lib/content/sample-data.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# (Tuỳ chọn) chỉ cần nếu dataset để chế độ private. Token quyền "Viewer".
SANITY_API_READ_TOKEN=

# Chuỗi bí mật bất kỳ – dùng cho webhook Sanity gọi /api/revalidate khi xuất bản bài
SANITY_REVALIDATE_SECRET=
